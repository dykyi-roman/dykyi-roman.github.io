 "titleRu": "Пространство, направление и базовые связки",
 "goal": "понимать и строить простые фразы о местоположении, направлении и движении в повседневной жизни в Испании.",
 "url": "spanish/stage-1.html",
 "intro": [
  {
   "k": "p",
   "spans": [
    {
     "t": "Первый этап — слова, которыми показывают на мир вокруг: где что находится, куда идти, чьё это и сколько. Сначала короткие слова — местоимения, указательные и притяжательные слова, предлоги места; формы одного слова по роду и числу даны вместе ("
    },
    {
     "t": "este / esta",
     "s": "es"
    },
    {
     "t": ", "
    },
    {
     "t": "mi / mis",
     "s": "es"
    },
    {
     "t": "). Под ними — живые примеры, которые пригодятся в первый же день."
    }
   ]
  },
  {
   "k": "p",
   "spans": [
    {
     "t": "Глаголов в лексике этапа нет: глаголы движения ("
    },
    {
     "t": "ir",
     "s": "es"
    },
    {
     "t": ", "
    },
    {
     "t": "venir",
     "s": "es"
    },
    {
     "t": ", "
    },
    {
     "t": "entrar",
     "s": "es"
    },
    {
     "t": ", "
    },
    {
     "t": "salir",
     "s": "es"
    },
    {
     "t": ", "
    },
    {
     "t": "volver",
     "s": "es"
    },
    {
     "t": "), а также "
    },
    {
     "t": "ser",
     "s": "es"
    },
    {
     "t": " и "
    },
    {
     "t": "estar",
     "s": "es"
    },
    {
     "t": " собраны в Words, а их формы — в правилах."
    }
   ]
  }
 ],
